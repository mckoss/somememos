{
  "name": "somememos",
  "version": "0.2.1",
  "private": true,
  "description": "A second brain made of plain markdown files, with time-aware working memory.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "node packages/core/scripts/gen-version.mjs",
    "gen:version": "node packages/core/scripts/gen-version.mjs",
    "build": "npm run build -w @somememos/core && npm run build -w @somememos/sqlite-store && npm run build -w @somememos/cli && npm run build -w @somememos/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "pretypecheck": "npm run gen:version",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run gen:version",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:privacy": "node scripts/check-no-brain-data.mjs",
    "check": "npm run check:privacy && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
