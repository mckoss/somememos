{
  "name": "@somememos/web",
  "version": "0.3.0",
  "private": true,
  "description": "The somememos server and PWA client (SvelteKit).",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p src/service-worker/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p e2e-storage/tsconfig.json",
    "test": "vitest run",
    "e2e:ui": "playwright test -c playwright.config.ts --trace off",
    "e2e:storage": "playwright test -c playwright.storage.config.ts --trace off",
    "e2e:sync": "playwright test -c playwright.sync.config.ts --trace off",
    "e2e": "npm run e2e:ui && STORAGE_SKIP_BUILD=1 npm run e2e:storage && npm run e2e:sync"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-node": "^6.0.6",
    "@sveltejs/kit": "^3.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@types/markdown-it": "^14.2.0",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "vite": "^8.4.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@lezer/highlight": "^1.2.1",
    "@somememos/core": "*",
    "@somememos/server": "*",
    "@somememos/sqlite-store": "*",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.5.0",
    "markdown-it": "^15.0.3"
  }
}
