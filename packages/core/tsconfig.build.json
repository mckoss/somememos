{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  // Tests, and test-only helpers (`*.testing.ts`, which import vitest, and
  // the synthetic brain generator in `src/testing/`), stay out of the build.
  "exclude": ["src/**/*.test.ts", "src/**/*.testing.ts", "src/testing/**"]
}
