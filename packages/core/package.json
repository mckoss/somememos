{
  "name": "@somememos/core",
  "version": "0.6.0",
  "private": true,
  "description": "Isomorphic somememos logic: TimeScore, chunking, links, indexing, ranking, the engine, evaluation.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing/storage": {
      "source": "./src/storage/conformance.testing.ts"
    },
    "./testing/engine": {
      "source": "./src/engine/conformance.testing.ts"
    },
    "./testing/brain": {
      "source": "./src/testing/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "prebuild": "npm run gen:version",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run gen:version",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "fast-check": "^4.11.0"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  }
}
