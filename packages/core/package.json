{
  "name": "@somememos/core",
  "version": "0.1.1",
  "private": true,
  "description": "Isomorphic somememos logic: TimeScore, chunking, links, ranking, evaluation.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
