{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node-only: the server's storage, over `pg`.
    "types": ["node"],
    "noEmit": true,
    // Resolve @somememos/core to its TypeScript source, so type-checking works
    // from a fresh clone without building core first.
    "customConditions": ["source"]
  },
  "include": ["src"]
}
