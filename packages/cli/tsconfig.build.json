{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Build against core's compiled output (dist), not its source.
    "customConditions": [],
    "rootDir": "src",
    "outDir": "dist"
  },
  // Tests and the test-only synthetic brain helpers (src/testing/) stay out of
  // the build.
  "exclude": ["src/**/*.test.ts", "src/testing/**"]
}
